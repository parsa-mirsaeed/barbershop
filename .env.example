# Copy to .env. The installer generates random passwords when .env does not exist.
WP_PORT=8080
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=replace-with-a-random-local-password
DB_ROOT_PASSWORD=replace-with-another-random-local-password
WP_URL=
WP_TITLE="[نام برند]"
WP_ADMIN_USER=siteadmin
WP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
WP_ADMIN_EMAIL=admin@example.test
