# Copy to .env.production and replace every value before deployment.
SITE_DOMAIN=shop.example.com
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=replace-with-a-long-random-production-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
WP_TITLE="[نام برند]"
WP_ADMIN_USER=siteadmin
WP_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
WP_ADMIN_EMAIL=admin@example.com
