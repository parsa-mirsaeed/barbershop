+/**
+ * Montix security overlay: only SMS-verified identities authenticate by OTP.
+ * Do NOT infer ownership from billing_phone, editable mobile_number or user_login.
+ * Previous Montix OTP accounts are trusted via their verified-only meta key.
+ */
+function farazsms_montix_is_customer( $user ) {
+    return $user instanceof \WP_User
+        && array_values( (array) $user->roles ) === array( 'customer' )
+        && ! user_can( $user, 'manage_options' )
+        && ! user_can( $user, 'edit_users' )
+        && ! user_can( $user, 'manage_woocommerce' );
+}
+
+function farazsms_montix_verified_customer_by_mobile( $raw_mobile ) {
+    $phone = farazsms_dedupe_normalize_mobile( $raw_mobile );
+    if ( ! $phone ) { return null; }
+    $users = array();
+    foreach ( array( '_farazsms_verified_phone', '_bsc_verified_phone' ) as $key ) {
+        foreach ( get_users( array(
+            'meta_key' => $key, 'meta_value' => farazsms_dedupe_mobile_variants( $phone ),
+            'meta_compare' => 'IN', 'number' => 3,
+        ) ) as $user ) {
+            $users[ (int) $user->ID ] = $user;
+        }
+    }
+    if ( count( $users ) !== 1 ) { return null; }
+    $user = reset( $users );
+    return farazsms_montix_is_customer( $user ) ? $user : null;
+}
+
+/** Deny enrollment if another account has claimed or received this phone. */
+function farazsms_montix_phone_claimable( $phone, $user_id ) {
+    $phone = farazsms_dedupe_normalize_mobile( $phone );
+    if ( ! $phone ) { return false; }
+    foreach ( array( '_farazsms_verified_phone', '_bsc_verified_phone' ) as $key ) {
+        $matches = get_users( array( 'meta_key' => $key,
+            'meta_value' => farazsms_dedupe_mobile_variants( $phone ),
+            'meta_compare' => 'IN', 'fields' => 'ID', 'number' => 3 ) );
+        foreach ( $matches as $id ) {
+            if ( (int) $id !== (int) $user_id ) { return false; }
+        }
+    }
+    return ! farazsms_find_user_ids_by_mobile( $phone, $user_id );
+}
