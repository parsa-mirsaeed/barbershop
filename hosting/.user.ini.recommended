; Recommended shared-hosting PHP baseline for Barbershop/WooCommerce.
; The provider may enforce lower/higher limits; apply through cPanel/DirectAdmin
; only where supported. Do not place secrets in this file.
memory_limit = 512M
max_execution_time = 120
max_input_time = 120
max_input_vars = 3000
upload_max_filesize = 32M
post_max_size = 32M
expose_php = Off
display_errors = Off
log_errors = On
session.cookie_httponly = 1
session.cookie_secure = 1
session.cookie_samesite = Lax
