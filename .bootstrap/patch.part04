+.woocommerce .woocommerce-breadcrumb,.woocommerce .woocommerce-result-count,.woocommerce .woocommerce-ordering,.woocommerce .product_meta { color:var(--pbs-muted); }
+.woocommerce ul.products,.woocommerce-page ul.products { display:grid;gap:1.15rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr)); }
+.woocommerce ul.products::before,.woocommerce ul.products::after { display:none; }
+.woocommerce ul.products li.product { background:#fff;border:1px solid #dce5ed;border-radius:1.45rem;box-shadow:0 16px 45px rgba(7,26,61,.09);display:flex;flex-direction:column;margin:0!important;overflow:hidden;padding:1rem;width:auto!important; }
+.woocommerce ul.products li.product img { aspect-ratio:1/1;background:#f1f5f8;border-radius:1.1rem;object-fit:cover; }
+.woocommerce ul.products li.product .woocommerce-loop-product__title { color:var(--pbs-ink);font-size:1.05rem;line-height:1.55; }
+.woocommerce ul.products li.product .price { color:var(--pbs-green);font-size:1rem;font-weight:900; }
+.woocommerce ul.products li.product .button { background:var(--pbs-green);border-radius:999px;color:#fff;margin-top:auto;text-align:center; }
+.woocommerce div.product,.woocommerce-cart-form,.woocommerce-checkout-review-order,.woocommerce form.checkout,.woocommerce form.login,.woocommerce form.register,.woocommerce-MyAccount-navigation,.woocommerce-MyAccount-content { background:rgba(255,255,255,.065);border:1px solid var(--pbs-line);border-radius:var(--pbs-radius);box-shadow:var(--pbs-shadow);padding:clamp(1rem,3vw,2rem); }
+.woocommerce div.product div.images img { border-radius:1.25rem; }
+.woocommerce div.product .product_title,.woocommerce table.shop_table,.woocommerce table.shop_table th,.woocommerce table.shop_table td,.woocommerce .cart_totals h2,.woocommerce-checkout h3,.woocommerce-account h2 { color:var(--pbs-text); }
+.woocommerce div.product p.price