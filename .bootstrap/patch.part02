     frame.on('select', () => {
       const attachment = frame.state().get('selection').first().toJSON();
+      let preview = document.querySelector(`[data-bsc-preview="${target}"]`);
+      if (!preview) {
+        const wrap = document.querySelector(`[data-bsc-preview-wrap="${target}"]`);
+        if (wrap) {
+          preview = document.createElement('img');
+          preview.dataset.bscPreview = target;
+          preview.alt = '';
+          wrap.appendChild(preview);
+        }
+      }
       input.value = String(attachment.id);
       if (preview) {
-        preview.src = attachment.sizes?.medium?.url || attachment.url;
+        preview.src = attachment.sizes?.thumbnail?.url || attachment.sizes?.medium?.url || attachment.url;
         preview.hidden = false;
       }
     });
diff --git a/plugin/barbershop-core/assets/frontend.css b/plugin/barbershop-core/assets/frontend.css
index 03a8ae9..61c1d08 100644
--- a/plugin/barbershop-core/assets/frontend.css
