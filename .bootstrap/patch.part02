@@ -1,12 +1,32 @@
+:root { --bsc-navy:#071a3d; --bsc-green:#0e8f6a; --bsc-white:#fff; --bsc-muted:#a9b8c8; }
+.bsc-category-grid { display:grid; gap:1.1rem; grid-template-columns:repeat(3,minmax(0,1fr)); }
+.bsc-category-card { min-width:0; }
+.bsc-category-card > a { background:linear-gradient(155deg,rgba(255,255,255,.065),rgba(14,143,106,.08)); border:1px solid rgba(255,255,255,.14); border-radius:1.75rem; color:var(--bsc-white); display:flex; flex-direction:column; height:100%; min-height:19rem; padding:clamp(1.3rem,3vw,2rem); text-decoration:none; transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease; }
+.bsc-category-card > a:hover { border-color:var(--bsc-green); box-shadow:0 24px 70px rgba(0,0,0,.25); transform:translateY(-5px); }
+.bsc-category-card__icon { align-items:center; background:rgba(14,143,106,.13); border:1px solid rgba(14,143,106,.45); border-radius:1.4rem; color:#23d6a7; display:flex; height:7rem; justify-content:center; margin-bottom:1.35rem; overflow:hidden; width:7rem; }
+.bsc-category-card__image, .bsc-category-card__fallback svg { height:5rem; object-fit:contain; width:5rem; }
+.bsc-category-card__title { font-size:clamp(1.25rem,2.5vw,1.75rem); font-weight:900; line-height:1.35; }
+.bsc-category-card__children { color:var(--bsc-muted); font-size:.92rem; line-height:1.9; margin-top:.65rem; }
+.bsc-category-card__action { color:#39e1b5; font-weight:800; margin-top:auto; padding-top:1.4rem; }
+.bsc-store-notice { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.14); border-radius:1rem; padding:1rem; }
+.bsc-cart-link, .bsc-account-link { align-items:center; border:1px solid rgba(255,255,255,.2); border-radius:999px; color:#fff !important; display:inline-flex; font-size:.9rem; font-weight:850; gap:.55rem; min-height:3rem; padding:.55rem .85rem; text-decoration:none !important; white-space:nowrap; }
+.bsc-cart-link { background:var(--bsc-green); border-color:var(--bsc-green); }
+.bsc-cart-link__icon { display:inline-flex; height:1.45rem; width:1.45rem; }
+.bsc-cart-link__icon svg { height:100%; width:100%; }
+.bsc-cart-link__count { align-items:center; background:#fff; border-radius:999px; color:var(--bsc-navy); display:inline-flex; font-size:.76rem; height:1.45rem; justify-content:center; min-width:1.45rem; padding:0 .28rem; }
+.bsc-cart-link--floating { bottom:1rem; box-shadow:0 14px 40px rgba(0,0,0,.36); display:none; left:1rem; position:fixed; z-index:1000; }
+.bsc-register-note { color:var(--bsc-muted); font-size:.82rem; line-height:1.7; }
 .bsc-ba-grid { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr)); }
-.bsc-ba { background:var(--pbs-card,rgba(255,248,235,.07)); border:1px solid var(--pbs-line,rgba(255,248,235,.14)); border-radius:1.5rem; overflow:hidden; }
+.bsc-ba { background:rgba(255,255,255,.065); border:1px solid rgba(255,255,255,.14); border-radius:1.5rem; overflow:hidden; }
 .bsc-ba__media { aspect-ratio:4/3; isolation:isolate; position:relative; }
 .bsc-ba__media img { display:block; height:100%; inset:0; object-fit:cover; position:absolute; width:100%; }
 .bsc-ba__after { clip-path:inset(0 50% 0 0); }
-.bsc-ba__range { cursor:ew-resize; inset:auto 1rem 1rem; position:absolute; width:calc(100% - 2rem); z-index:3; }
-.bsc-ba__labels { display:flex; font-size:.75rem; font-weight:800; inset:.8rem .8rem auto; justify-content:space-between; pointer-events:none; position:absolute; z-index:2; }
-.bsc-ba__labels span { background:rgba(15,12,8,.78); border-radius:999px; color:#fff7ea; padding:.35rem .65rem; }
+.bsc-ba__range { bottom:1rem; cursor:ew-resize; left:1rem; position:absolute; width:calc(100% - 2rem); z-index:3; }
+.bsc-ba__labels { display:flex; inset:.8rem .8rem auto; justify-content:space-between; pointer-events:none; position:absolute; z-index:2; }
+.bsc-ba__labels span { background:rgba(7,26,61,.82); border-radius:999px; color:#fff; font-size:.75rem; font-weight:800; padding:.35rem .65rem; }
 .bsc-ba__body { padding:1rem 1.1rem 1.2rem; }
 .bsc-ba__body h3,.bsc-ba__body p { margin-block:0; }
-.bsc-ba__body p { color:var(--pbs-muted,#b9a994); margin-block-start:.5rem; }
-@media (prefers-reduced-motion:reduce) { .bsc-ba__after { transition:none; } }
+.bsc-ba__body p { color:var(--bsc-muted); margin-block-start:.5rem; }
+@media (max-width:900px) { .bsc-category-grid { grid-template-columns:1fr; } .bsc-category-card > a { min-height:15rem; } }
+@media (max-width:781px) { .bsc-cart-link--floating { display:inline-flex; } .bsc-cart-link__label { display:none; } }
+@media (prefers-reduced-motion:reduce) { .bsc-category-card > a,.bsc-ba__after { transition:none; } }
